@{
    ViewData["Title"] = "Email Terkirim - SisJad";
    Layout = null;
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f8fafc">
    <title>Email Terkirim - SisJad</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        :root {
            --primary: #0d9488;
            --primary-hover: #0f766e;
            --primary-light: #f0fdfa;
            --primary-border: #99f6e4;
            --bg-base: #f8fafc;
            --bg-card: #ffffff;
            --border-subtle: #e2e8f0;
            --text-heading: #0f172a;
            --text-body: #334155;
            --text-muted: #64748b;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            height: 100vh;
            max-height: 100vh;
            overflow: hidden;
            background: var(--bg-base);
            font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
            color: var(--text-body);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .auth-card {
            width: 100%;
            max-width: 420px;
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 14px;
            padding: 42px 34px;
            text-align: center;
            box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
        }

        .icon-box {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            background: var(--primary-light);
            border: 1px solid var(--primary-border);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px;
            color: var(--primary);
            font-size: 24px;
        }

        h1 {
            font-size: 20px;
            font-weight: 800;
            color: var(--text-heading);
            margin-bottom: 10px;
        }

        p {
            font-size: 13px;
            color: var(--text-muted);
            line-height: 1.6;
            margin-bottom: 6px;
        }

        .btn-return {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 24px;
            width: 100%;
            height: 44px;
            background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
            color: #ffffff;
            text-decoration: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 700;
            box-shadow: 0 4px 14px rgba(13, 148, 136, 0.25);
            transition: all 0.15s ease;
        }

        .btn-return:hover {
            background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);
        }

        .hint {
            margin-top: 16px;
            font-size: 12px;
            color: #94a3b8;
        }
    </style>
</head>
<body>
    <main class="auth-card">
        <div class="icon-box">
            <i class="fas fa-envelope-circle-check"></i>
        </div>
        <h1>Tautan Telah Dikirim</h1>
        <p>@(TempData["ForgotPasswordSuccess"] ?? "Jika email Anda terdaftar di sistem, instruksi reset kata sandi telah dikirimkan.")</p>
        <p>Silakan periksa kotak masuk (inbox) atau folder spam email Anda.</p>

        <a asp-action="Login" asp-controller="Account" class="btn-return">
            <i class="fas fa-arrow-left"></i> Kembali ke Halaman Masuk
        </a>

        <div class="hint">Tautan reset berlaku selama 1 jam sejak dikirim.</div>
    </main>
</body>
</html>
