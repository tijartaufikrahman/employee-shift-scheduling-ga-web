@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="theme-color" content="#0c1322" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] - Sistem Penjadwalan</title>

    <!-- Google Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- DataTables 1.13.7 Bootstrap 5 & Responsive CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />

    <!-- Handcrafted Modern Admin CSS -->
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    @{
        var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Karyawan";
        var userName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Pengguna";
        var userInitial = userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "U";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var isManager = userRole == "Manager" || userRole == "Admin";
        var homeUrl = isManager ? "/Admin/Dashboard" : "/Home/Index";

        // Khusus Dashboard di semua role tidak menampilkan breadcrumb di kanan atas
        bool isDashboard = currentAction.Equals("Dashboard", StringComparison.OrdinalIgnoreCase)
            || (currentController.Equals("Admin", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Dashboard", StringComparison.OrdinalIgnoreCase))
            || (currentController.Equals("Home", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Index", StringComparison.OrdinalIgnoreCase))
            || (ViewData["HideBreadcrumbs"] as bool? == true);
    }

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Sidebar -->
        <nav class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <a href="@homeUrl" class="sidebar-brand">
                    <div class="brand-icon-box">
                        <i class="fas fa-calendar-days"></i>
                    </div>
                    <div class="brand-text-block">
                        <div class="brand-title-row">
                            <h3 class="brand-name">SisJad</h3>
                            <span class="brand-tag-pill">@userRole</span>
                        </div>
                        <span class="brand-tagline">Sistem Penjadwalan Kerja</span>
                    </div>
                </a>
            </div>

            <div class="sidebar-nav-container" id="sidebarNav">
                <div class="nav-section-title">UTAMA</div>
                @if (isManager)
                {
                    var isDashActive = currentController.Equals("Admin", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Dashboard", StringComparison.OrdinalIgnoreCase);
                    var isSchedActive = currentController.Equals("Schedule", StringComparison.OrdinalIgnoreCase);
                    var isShiftActive = currentController.Equals("ShiftType", StringComparison.OrdinalIgnoreCase);
                    var isEmpActive = currentController.Equals("Employee", StringComparison.OrdinalIgnoreCase);
                    var isLeaveActive = currentController.Equals("LeaveRequest", StringComparison.OrdinalIgnoreCase);
                    var isAnnActive = currentController.Equals("Announcement", StringComparison.OrdinalIgnoreCase);

                    <a class="sidebar-link @(isDashActive ? "active" : "")" href="/Admin/Dashboard">
                        <i class="fas fa-chart-pie link-icon"></i>
                        <span>Dashboard</span>
                    </a>
                    
                    <div class="nav-section-title">MASTER</div>
                    <a class="sidebar-link @(isEmpActive ? "active" : "")" href="/Employee/Index">
                        <i class="fas fa-users link-icon"></i>
                        <span>Karyawan</span>
                    </a>
                    <a class="sidebar-link @(isShiftActive ? "active" : "")" href="/ShiftType/Index">
                        <i class="fas fa-clock link-icon"></i>
                        <span>Tipe Shift</span>
                    </a>

                    <div class="nav-section-title">JADWAL</div>
                    <a class="sidebar-link @(isSchedActive && !currentAction.Equals("History", StringComparison.OrdinalIgnoreCase) && !currentAction.Equals("StaffCalculator", StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="/Schedule/Index">
                        <i class="fas fa-calendar-alt link-icon"></i>
                        <span>Penjadwalan</span>
                    </a>
                    <a class="sidebar-link @(isSchedActive && currentAction.Equals("StaffCalculator", StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="/Schedule/StaffCalculator">
                        <i class="fas fa-calculator link-icon"></i>
                        <span>Kalkulator Kebutuhan Karyawan</span>
                    </a>
                    <a class="sidebar-link @(isSchedActive && currentAction.Equals("History", StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="/Schedule/History">
                        <i class="fas fa-clock-rotate-left link-icon"></i>
                        <span>Riwayat Jadwal</span>
                    </a>

                    <div class="nav-section-title">OPERASIONAL</div>
                    <a class="sidebar-link @(isLeaveActive ? "active" : "")" href="/LeaveRequest/Index">
                        <i class="fas fa-envelope-open-text link-icon"></i>
                        <span>Laporan Pengajuan</span>
                    </a>
                    <a class="sidebar-link @(isAnnActive ? "active" : "")" href="/Announcement/Index">
                        <i class="fas fa-bullhorn link-icon"></i>
                        <span>Pengumuman</span>
                    </a>
                }
                else
                {
                    var isHomeActive = currentController.Equals("Home", StringComparison.OrdinalIgnoreCase);
                    var isLeaveActive = currentController.Equals("LeaveRequest", StringComparison.OrdinalIgnoreCase);

                    <a class="sidebar-link @(isHomeActive ? "active" : "")" href="/Home/Index">
                        <i class="fas fa-chart-pie link-icon"></i>
                        <span>Jadwal Saya</span>
                    </a>
                    <a class="sidebar-link @(isLeaveActive ? "active" : "")" href="/LeaveRequest/Index">
                        <i class="fas fa-envelope-open-text link-icon"></i>
                        <span>Pengajuan Izin</span>
                    </a>
                }
            </div>

            <div class="sidebar-bottom">
                <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" style="margin:0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-sidebar-exit-wide" title="Keluar dari Sistem">
                        <i class="fas fa-arrow-right-from-bracket"></i>
                        <span>Logout</span>
                    </button>
                </form>
            </div>
        </nav>

        <!-- Topbar -->
        <header class="topbar">
            <div class="topbar-left">
                <button type="button" class="btn-menu-toggle" id="menuToggle" aria-label="Toggle Sidebar">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="topbar-page-label">
                    <h2 class="topbar-page-title">@ViewData["Title"]</h2>
                </div>
            </div>

            <div class="topbar-right">
                <div class="topbar-user-avatar" title="@userName">@userInitial</div>
                <div class="topbar-user-meta">
                    <div class="topbar-user-name" title="@userName">@userName</div>
                    <div class="topbar-user-role">
                        <span class="role-status-dot"></span>
                        <span>@userRole</span>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Content Area -->
        <div class="main-content" id="mainContent">
            @if (!isDashboard)
            {
                <!-- Clean Text Breadcrumbs Di Kanan (Tanpa Card, Tanpa Icon, Tanpa Badge) -->
                <div class="content-breadcrumb-row">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumbs-trail">
                            @if (IsSectionDefined("Breadcrumbs"))
                            {
                                @await RenderSectionAsync("Breadcrumbs", required: false)
                            }
                            else
                            {
                                @if (currentController.Equals("Admin", StringComparison.OrdinalIgnoreCase))
                                {
                                    <li class="breadcrumbs-active">Dashboard</li>
                                }
                                else if (currentController.Equals("Employee", StringComparison.OrdinalIgnoreCase))
                                {
                                    <li><span>Data Master</span></li>
                                    <li class="breadcrumbs-sep">/</li>
                                    <li class="breadcrumbs-active">Karyawan</li>
                                }
                                else if (currentController.Equals("ShiftType", StringComparison.OrdinalIgnoreCase))
                                {
                                    <li><span>Data Master</span></li>
                                    <li class="breadcrumbs-sep">/</li>
                                    <li class="breadcrumbs-active">Tipe Shift</li>
                                }
                                else if (currentController.Equals("Schedule", StringComparison.OrdinalIgnoreCase))
                                {
                                    if (currentAction.Equals("Detail", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <li><a href="/Schedule/Index">Penjadwalan</a></li>
                                        <li class="breadcrumbs-sep">/</li>
                                        <li class="breadcrumbs-active">Detail Jadwal</li>
                                    }
                                    else if (currentAction.Equals("Generate", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <li><a href="/Schedule/Index">Penjadwalan</a></li>
                                        <li class="breadcrumbs-sep">/</li>
                                        <li class="breadcrumbs-active">Generate Baru</li>
                                    }
                                    else if (currentAction.Equals("Preview", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <li><a href="/Schedule/Index">Penjadwalan</a></li>
                                        <li class="breadcrumbs-sep">/</li>
                                        <li class="breadcrumbs-active">Pratinjau</li>
                                    }
                                    else if (currentAction.Equals("Emergency", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <li><a href="/Schedule/Index">Penjadwalan</a></li>
                                        <li class="breadcrumbs-sep">/</li>
                                        <li class="breadcrumbs-active">Pengganti Darurat</li>
                                    }
                                    else if (currentAction.Equals("StaffCalculator", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <li><a href="/Schedule/Index">Penjadwalan</a></li>
                                        <li class="breadcrumbs-sep">/</li>
                                        <li class="breadcrumbs-active">Kalkulator Kebutuhan Karyawan</li>
                                    }
                                    else if (currentAction.Equals("History", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <li><a href="/Schedule/Index">Penjadwalan</a></li>
                                        <li class="breadcrumbs-sep">/</li>
                                        <li class="breadcrumbs-active">Riwayat Jadwal</li>
                                    }
                                    else
                                    {
                                        <li class="breadcrumbs-active">Penjadwalan</li>
                                    }
                                }
                                else if (currentController.Equals("LeaveRequest", StringComparison.OrdinalIgnoreCase))
                                {
                                    <li><span>Operasional</span></li>
                                    <li class="breadcrumbs-sep">/</li>
                                    if (currentAction.Equals("Detail", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <li><a href="/LeaveRequest/Index">@(isManager ? "Laporan Pengajuan" : "Pengajuan Izin")</a></li>
                                        <li class="breadcrumbs-sep">/</li>
                                        <li class="breadcrumbs-active">Detail Permohonan</li>
                                    }
                                    else if (currentAction.Equals("Create", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <li><a href="/LeaveRequest/Index">@(isManager ? "Laporan Pengajuan" : "Pengajuan Izin")</a></li>
                                        <li class="breadcrumbs-sep">/</li>
                                        <li class="breadcrumbs-active">Ajukan Izin Baru</li>
                                    }
                                    else
                                    {
                                        <li class="breadcrumbs-active">@(isManager ? "Laporan Pengajuan" : "Pengajuan Izin")</li>
                                    }
                                }
                                else if (currentController.Equals("Announcement", StringComparison.OrdinalIgnoreCase))
                                {
                                    <li><span>Operasional</span></li>
                                    <li class="breadcrumbs-sep">/</li>
                                    <li class="breadcrumbs-active">Pengumuman</li>
                                }
                                else if (currentController.Equals("Home", StringComparison.OrdinalIgnoreCase))
                                {
                                    <li class="breadcrumbs-active">Jadwal Saya</li>
                                }
                                else
                                {
                                    <li class="breadcrumbs-active">@ViewData["Title"]</li>
                                }
                            }
                        </ol>
                    </nav>
                </div>
            }

            @RenderBody()
        </div>

        <!-- Mobile Overlay Backdrop -->
        <div class="sidebar-overlay-backdrop" id="sidebarOverlay"></div>
    }
    else
    {
        @RenderBody()
    }

    <!-- Core Libraries -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

    <!-- App JS -->
    <script src="~/js/admin.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Berhasil!',
                text: '@Html.Raw(TempData["SuccessMessage"])',
                timer: 2200,
                showConfirmButton: false
            });
        </script>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Perhatian',
                text: '@Html.Raw(TempData["ErrorMessage"])'
            });
        </script>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <script>
            Swal.fire({
                icon: 'info',
                title: 'Informasi',
                text: '@Html.Raw(TempData["InfoMessage"])',
                timer: 2500,
                showConfirmButton: false
            });
        </script>
    }
</body>
</html>
