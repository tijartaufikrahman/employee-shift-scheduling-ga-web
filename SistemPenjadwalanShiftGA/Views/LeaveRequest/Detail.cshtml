@using SistemPenjadwalanShiftGA.Models.ViewModels
@model LeaveRequestDetailViewModel
@{
    ViewData["Title"] = "Detail Permohonan Izin";
    bool isManager = User.IsInRole("Manager") || User.IsInRole("Admin");
    var pillClass = Model.Status == "Approved" ? "pill-active" : (Model.Status == "Rejected" ? "pill-inactive" : "pill-pending");
    var statusLabel = Model.Status == "Approved" ? "Disetujui" : (Model.Status == "Rejected" ? "Ditolak" : "Pending");
}

<!-- Top Action Bar -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div class="d-flex align-items-center gap-2">
        <span class="status-pill @pillClass"><span class="dot-indicator"></span>@statusLabel</span>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        @if (isManager || Model.Status == "Pending")
        {
            <button type="button" class="btn-danger-admin py-1.5 px-3" style="font-size:0.8rem; font-weight:600;" onclick="deleteLeaveDetail('@Model.Id')">
                <i class="fas fa-trash-can me-1.5"></i> Hapus Permohonan
            </button>
        }
        <a href="/LeaveRequest/Index" class="btn-secondary-admin py-1.5 px-3" style="font-size:0.8rem;">
            <i class="fas fa-arrow-left me-1"></i> Kembali ke Daftar
        </a>
    </div>
</div>

<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<div class="row g-3">
    <!-- Left Column: Details & Review Notes -->
    <div class="col-lg-7">
        <div class="admin-card mb-3">
            <div class="admin-card-header">
                <div>
                    <h3 class="admin-card-title">Rincian Pengajuan</h3>
                    <p class="admin-card-desc">Informasi identitas pemohon dan alasan ketidakhadiran</p>
                </div>
                <span class="code-tag" style="font-weight:700;">@Model.LeaveType</span>
            </div>
            <div class="admin-card-body p-3" style="font-size:0.83rem;">
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted"><i class="fas fa-user me-1 text-teal"></i> Nama Karyawan</span>
                    <strong style="color:#0f172a;">@Model.EmployeeName</strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted"><i class="fas fa-tag me-1 text-teal"></i> Jenis Permohonan</span>
                    <strong style="color:#0f172a;">@Model.LeaveType</strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted"><i class="fas fa-calendar-day me-1 text-teal"></i> Tanggal Izin</span>
                    <strong style="color:#0f172a;">@Model.RequestDate.ToString("dd MMMM yyyy")</strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted"><i class="fas fa-clock me-1 text-muted"></i> Waktu Pengajuan</span>
                    <span style="color:#475569;">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</span>
                </div>
                <div class="py-3">
                    <span class="text-muted d-block mb-1"><i class="fas fa-comment-dots me-1 text-teal"></i> Alasan Pengajuan:</span>
                    <div class="p-3 rounded-2" style="background:#f8fafc; border:1px solid #e2e8f0; color:#334155; line-height:1.6;">
                        @Model.Reason
                    </div>
                </div>
            </div>
        </div>

        @if(Model.Status != "Pending")
        {
            <div class="admin-card">
                <div class="admin-card-header">
                    <div>
                        <h3 class="admin-card-title">
                            Catatan & Riwayat Review
                        </h3>
                    </div>
                </div>
                <div class="admin-card-body p-3" style="font-size:0.82rem;">
                    <div class="d-flex justify-content-between align-items-center py-1">
                        <span class="text-muted">Status Keputusan:</span>
                        <span class="status-pill @pillClass" style="font-size:0.74rem;">
                            <span class="dot-indicator"></span>@statusLabel
                        </span>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted">Ditinjau Oleh:</span>
                        <strong style="color:#0f172a;">@(Model.ReviewedByName ?? "Manager")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted">Tanggal Keputusan:</span>
                        <span>@(Model.ReviewedAt?.ToString("dd MMM yyyy HH:mm") ?? "-")</span>
                    </div>
                    @if(!string.IsNullOrEmpty(Model.RejectionNote))
                    {
                        <div class="p-3 mt-2 rounded-2" style="background:#fef2f2; border:1px solid #fecaca; color:#991b1b;">
                            <strong>Alasan Penolakan:</strong><br/>
                            @Model.RejectionNote
                        </div>
                    }

                    @if(isManager)
                    {
                        <div class="mt-3 pt-2 border-top">
                            <button type="button" class="btn btn-outline-secondary btn-sm w-100" style="font-size:0.78rem;" onclick="toggleChangeDecision()">
                                <i class="fas fa-rotate me-1 text-teal"></i> Ubah Status Keputusan Review
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Right Column: Lampiran / Bukti Dokumen -->
    <div class="col-lg-5">
        <div class="admin-card">
            <div class="admin-card-header">
                <div>
                    <h3 class="admin-card-title">Dokumen Lampiran</h3>
                    <p class="admin-card-desc">Bukti pendukung surat dokter atau form cuti</p>
                </div>
                <span class="code-tag"><i class="fas fa-paperclip me-1 text-teal"></i>@(Model.Attachments?.Count ?? 0) File</span>
            </div>
            <div class="admin-card-body p-3">
                @if (Model.Attachments == null || !Model.Attachments.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fas fa-folder-open fa-2x mb-2" style="color:#cbd5e1;"></i>
                        <p class="mb-0" style="font-size:0.83rem;">Tidak ada dokumen lampiran yang diunggah.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var att in Model.Attachments)
                        {
                            var isImg = att.FileType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
                            <div class="p-2 rounded-2 d-flex align-items-center justify-content-between" style="background:#f8fafc; border:1px solid #e2e8f0;">
                                <div class="d-flex align-items-center gap-2 overflow-hidden">
                                    <div style="width:36px; height:36px; border-radius:6px; background:@(isImg ? "#ecfdf5" : "#eff6ff"); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                        <i class="fas @(isImg ? "fa-file-image text-success" : "fa-file-pdf text-primary")"></i>
                                    </div>
                                    <div class="overflow-hidden">
                                        <div class="text-truncate" style="font-weight:600; font-size:0.82rem; color:#1e293b;" title="@att.FileName">@att.FileName</div>
                                        <small class="text-muted" style="font-size:0.75rem;">@((att.FileSize / 1024.0).ToString("0.#")) KB</small>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <a href="@att.FilePath" target="_blank" class="btn btn-sm btn-outline-secondary" style="font-size:0.75rem; padding:3px 8px;" title="Buka / Unduh File">
                                        <i class="fas fa-arrow-up-right-from-square"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Manager Review Form Box -->
        @if (isManager)
        {
            <div class="admin-card mt-3" id="reviewCard" style="@(Model.Status == "Pending" ? "" : "display:none;")">
                <div class="admin-card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="admin-card-title">@(Model.Status == "Pending" ? "Tindakan Persetujuan" : "Ubah Keputusan Review")</h3>
                        <p class="admin-card-desc">Tinjau permohonan karyawan untuk jadwal kerja operasional</p>
                    </div>
                    @if(Model.Status != "Pending")
                    {
                        <button type="button" class="btn-secondary-admin" style="font-size:0.75rem; padding:3px 8px;" onclick="toggleChangeDecision()">
                            <i class="fas fa-times"></i> Tutup
                        </button>
                    }
                </div>
                <div class="admin-card-body p-3">
                    <form asp-action="Review" method="post" id="reviewForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@Model.Id" />
                        <input type="hidden" name="Status" id="reviewStatus" value="" />

                        <!-- State 1: Action Buttons (Approve / Reject) -->
                        <div id="defaultActionButtons" class="d-flex gap-2">
                            <button type="button" class="btn btn-success flex-grow-1 py-2" style="font-size:0.85rem; font-weight:600;" onclick="approveRequest()">
                                <i class="fas fa-check-circle me-1"></i> Setujui Permohonan
                            </button>
                            <button type="button" class="btn btn-outline-danger flex-grow-1 py-2" style="font-size:0.85rem; font-weight:600;" onclick="openRejectBox()">
                                <i class="fas fa-ban me-1"></i> Tolak Permohonan
                            </button>
                        </div>

                        <!-- State 2: Rejection Input Panel (Only shown when rejecting) -->
                        <div id="rejectNoteGroup" style="display:none;" class="p-3 rounded-2 border border-danger-subtle bg-danger-subtle bg-opacity-10 mt-2">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label mb-0 text-danger fw-bold" style="font-size:0.82rem;">
                                    <i class="fas fa-circle-exclamation me-1"></i> Alasan / Catatan Penolakan <span class="text-danger">*</span>
                                </label>
                            </div>
                            <textarea name="RejectionNote" id="rejectionNote" class="form-control mb-3" rows="3" placeholder="Tuliskan alasan penolakan permohonan izin ini agar karyawan mengetahui kendalanya..."></textarea>
                            
                            <div class="d-flex gap-2 justify-content-end">
                                <button type="button" class="btn btn-secondary px-3" style="font-size:0.82rem;" onclick="cancelRejectBox()">
                                    <i class="fas fa-arrow-left me-1"></i> Batal
                                </button>
                                <button type="button" class="btn btn-danger px-4" style="font-size:0.82rem; font-weight:600;" onclick="confirmReject()">
                                    <i class="fas fa-ban me-1"></i> Konfirmasi Tolak Permohonan
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function approveRequest() {
            $('#rejectNoteGroup').hide();
            $('#defaultActionButtons').show();

            Swal.fire({
                title: 'Setujui Permohonan Izin?',
                text: 'Permohonan ini akan disetujui resmi dan karyawan akan dialokasikan libur (OFF) pada jadwal kerja.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Ya, Setujui!',
                cancelButtonText: 'Batal'
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#reviewStatus').val('Approved');
                    $('#rejectionNote').val('');
                    $('#reviewForm').submit();
                }
            });
        }

        function openRejectBox() {
            $('#defaultActionButtons').slideUp(150);
            $('#rejectNoteGroup').slideDown(200);
            $('#rejectionNote').focus();
        }

        function cancelRejectBox() {
            $('#rejectNoteGroup').slideUp(150);
            $('#defaultActionButtons').slideDown(200);
            $('#rejectionNote').val('');
        }

        function confirmReject() {
            var noteVal = $('#rejectionNote').val().trim();
            if (!noteVal) {
                Swal.fire('Catatan Diperlukan', 'Harap isi alasan penolakan sebelum mengirimkan keputusan tolak.', 'warning');
                $('#rejectionNote').focus();
                return;
            }

            Swal.fire({
                title: 'Tolak Permohonan Izin?',
                text: 'Permohonan ini akan ditolak dan karyawan TIDAK AKAN dialokasikan libur (tetap siap bertugas).',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Ya, Tolak Permohonan!',
                cancelButtonText: 'Batal'
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#reviewStatus').val('Rejected');
                    $('#reviewForm').submit();
                }
            });
        }

        function toggleChangeDecision() {
            $('#reviewCard').slideToggle(200);
            $('#rejectNoteGroup').hide();
            $('#defaultActionButtons').show();
        }

        function deleteLeaveDetail(id) {
            Swal.fire({
                title: 'Hapus Data Izin / Cuti?',
                text: 'Data permohonan izin ini beserta dokumen lampirannya akan dihapus permanen dari sistem.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Ya, Hapus!',
                cancelButtonText: 'Batal'
            }).then((result) => {
                if (result.isConfirmed) {
                    var token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();
                    $.ajax({
                        url: '/LeaveRequest/Delete/' + id,
                        type: 'POST',
                        data: { __RequestVerificationToken: token },
                        success: function(res) {
                            if (res.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Berhasil Dihapus!',
                                    text: res.message,
                                    timer: 1600,
                                    showConfirmButton: false
                                }).then(() => {
                                    window.location.href = '/LeaveRequest/Index';
                                });
                            } else {
                                Swal.fire('Gagal!', res.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Gagal!', 'Terjadi kesalahan komunikasi dengan server.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
