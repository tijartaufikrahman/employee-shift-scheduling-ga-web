@using SistemPenjadwalanShiftGA.Models.Entities
@using SistemPenjadwalanShiftGA.Models.ViewModels
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["HideBreadcrumbs"] = true;
}

<!-- Pending Leave Alert Banner (If pending exists) -->
@if (Model.PendingLeaveRequests > 0)
{
    <div class="alert d-flex align-items-center justify-content-between p-3 mb-4 rounded-3 border-0" style="background: #fffbeb; border-left: 4px solid #f59e0b !important;">
        <div class="d-flex align-items-center gap-2">
            <i class="fas fa-bell text-warning fs-5"></i>
            <span class="small fw-semibold text-dark">
                Terdapat <strong class="text-warning">@Model.PendingLeaveRequests</strong> permohonan dispensasi izin dan cuti karyawan yang memerlukan verifikasi persetujuan.
            </span>
        </div>
        <a href="/LeaveRequest/Index" class="btn-primary-admin" style="padding: 4px 12px; font-size: 0.78rem;">
            Tinjau Permohonan <i class="fas fa-arrow-right ms-1"></i>
        </a>
    </div>
}

<!-- 3 Key Stat Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-lg-4 col-md-4 col-sm-12">
        <div class="stat-card-box">
            <div class="stat-header">
                <span class="stat-label-text">Total Karyawan Operasional</span>
                <div class="stat-icon-wrapper stat-icon-teal">
                    <i class="fas fa-users"></i>
                </div>
            </div>
            <div>
                <div class="stat-number-value">@Model.TotalKaryawan</div>
                <div class="stat-subtext">
                    <span class="status-pill pill-active">Aktif</span>
                    <span>Karyawan terdaftar</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-md-4 col-sm-12">
        <div class="stat-card-box">
            <div class="stat-header">
                <span class="stat-label-text">Tipe Shift Kerja</span>
                <div class="stat-icon-wrapper stat-icon-blue">
                    <i class="fas fa-clock"></i>
                </div>
            </div>
            <div>
                <div class="stat-number-value">@Model.TotalShiftTypes</div>
                <div class="stat-subtext">
                    <span class="status-pill pill-role">Konfigurasi</span>
                    <span>Slot rotasi shift</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-md-4 col-sm-12">
        <div class="stat-card-box">
            <div class="stat-header">
                <span class="stat-label-text">Permohonan Pending</span>
                <div class="stat-icon-wrapper stat-icon-amber">
                    <i class="fas fa-envelope-open-text"></i>
                </div>
            </div>
            <div>
                <div class="stat-number-value">@Model.PendingLeaveRequests</div>
                <div class="stat-subtext">
                    <span class="status-pill pill-pending">Verifikasi</span>
                    <span>Menunggu persetujuan</span>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    var hasPendingLeaves = Model.RecentLeaveRequests != null && Model.RecentLeaveRequests.Any();
}

<!-- Main Content Grid -->
<div class="row g-3">
    @if (hasPendingLeaves)
    {
        <!-- Left Column: Pending Leave Requests -->
        <div class="col-lg-8">
            <!-- Recent Leave Requests Table Card -->
            <div class="admin-card mb-3">
                <div class="admin-card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="admin-card-title d-flex align-items-center gap-2">
                            Laporan Pengajuan
                            <span class="badge" style="background:#fef3c7; color:#92400e; border:1px solid #fcd34d; font-size:0.72rem; font-weight:700;">
                                @(Model.RecentLeaveRequests?.Count ?? 0) Menunggu Verifikasi
                            </span>
                        </h3>
                        <p class="admin-card-desc mb-0">Daftar pengajuan dispensasi ketidakhadiran karyawan yang belum diverifikasi</p>
                    </div>
                    <a href="/LeaveRequest/Index" class="btn-secondary-admin" style="font-size:0.78rem;">
                        Lihat Semua <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="admin-card-body p-0">
                    <div class="admin-table-container">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th style="width: 40px; text-align: center;">NO</th>
                                    <th>NAMA KARYAWAN</th>
                                    <th>JENIS PENGAJUAN</th>
                                    <th>TANGGAL PENGAJUAN</th>
                                    <th>KETERANGAN</th>
                                    <th>STATUS</th>
                                    <th style="text-align: right;">AKSI</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int dashLeaveNo = 1; }
                                @foreach (var leave in Model.RecentLeaveRequests)
                                {
                                    var initial = !string.IsNullOrEmpty(leave.User?.NamaLengkap) ? leave.User.NamaLengkap.Substring(0, 1).ToUpper() : "U";

                                    <tr>
                                        <td style="text-align: center; font-weight: 600; color: #64748b;">@(dashLeaveNo++)</td>
                                        <td>
                                            <div class="avatar-cell">
                                                <div class="avatar-circle">@initial</div>
                                                <div>
                                                    <strong style="color: #0f172a; font-size: 0.85rem;">@(leave.User?.NamaLengkap ?? "-")</strong>
                                                    <small class="text-muted d-block" style="font-size: 0.72rem;">@(leave.User?.Email ?? "")</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="code-tag" style="font-weight: 700;">@leave.LeaveType</span>
                                        </td>
                                        <td style="font-size: 0.82rem; color: #334155; font-weight: 500;">
                                            @leave.RequestDate.ToString("dd MMM yyyy")
                                        </td>
                                        <td style="font-size: 0.8rem; color: #64748b; max-width: 180px;" class="text-truncate" title="@leave.Reason">
                                            @leave.Reason
                                        </td>
                                        <td>
                                            <span class="status-pill pill-pending" style="font-size: 0.72rem;">
                                                <span class="dot-indicator"></span>Menunggu Verifikasi
                                            </span>
                                        </td>
                                        <td style="text-align: right;">
                                            <a href="/LeaveRequest/Detail/@leave.Id" class="btn-table-action btn-table-view" title="Verifikasi / Tinjau Pengajuan">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Active Schedule Period & System Info -->
        <div class="col-lg-4">
            <!-- Active Period Card -->
            <div class="admin-card mb-3">
                <div class="admin-card-header">
                    <div>
                        <h3 class="admin-card-title">
                            Periode Jadwal Berjalan
                        </h3>
                        <p class="admin-card-desc">Periode jadwal kerja operasional karyawan yang resmi berlaku saat ini</p>
                    </div>
                </div>
                <div class="admin-card-body">
                    @if (Model.ActivePeriod != null)
                    {
                        <div class="p-3 rounded-3" style="background:#f0fdfa; border:1px solid #99f6e4;">
                            <div class="mb-2">
                                <span class="status-pill pill-active" style="font-size: 0.72rem; padding: 2.5px 8.5px; font-weight: 600;">
                                    <span class="dot-indicator pulse-dot"></span>Sedang Berjalan
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
                                <span class="badge" style="background: #ffffff; color: #0f766e; border: 1px solid #99f6e4; font-family: monospace; font-size: 0.78rem; font-weight: 700; padding: 3px 8px;">
                                    @(string.IsNullOrEmpty(Model.ActivePeriod.ScheduleCode) ? $"SCH-{Model.ActivePeriod.Id:D4}" : Model.ActivePeriod.ScheduleCode)
                                </span>
                                <h6 class="fw-bold mb-0 text-slate-900" style="font-size:0.95rem;">@Model.ActivePeriod.PeriodName</h6>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="/Schedule/Detail/@Model.ActivePeriod.Id" class="btn-primary-admin" style="font-size:0.76rem; padding:5px 12px;">
                                    Lihat Jadwal
                                </a>
                                <a href="/Schedule/ExportPdf/@Model.ActivePeriod.Id" target="_blank" class="btn-secondary-admin" style="font-size:0.76rem; padding:5px 12px;">
                                    Dokumen PDF
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted" style="font-size:0.82rem;">
                            Saat ini tidak terdapat periode jadwal operasional yang aktif.
                            <div class="mt-3">
                                <a href="/Schedule/Generate" class="btn-primary-admin" style="font-size:0.76rem;">
                                    Buat Jadwal Baru
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- System & Engine Specs Card -->
            <div class="admin-card">
                <div class="admin-card-header">
                    <div>
                        <h3 class="admin-card-title d-flex align-items-center gap-2">
                            Informasi Sistem
                            <span class="badge" style="background: #f0fdfa; color: #0f766e; border: 1px solid #99f6e4; font-weight: 700; font-size: 0.72rem; padding: 2px 7px;">v1</span>
                        </h3>
                        <p class="admin-card-desc">Parameter arsitektur dan konfigurasi operasional sistem informasi</p>
                    </div>
                </div>
                <div class="admin-card-body p-3" style="font-size:0.78rem;">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Metode Optimasi</span>
                        <strong style="color:#0f172a;">Algoritma Genetika (GA)</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Arsitektur Framework</span>
                        <strong style="color:#0f172a;">ASP.NET Core MVC (Enterprise)</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Basis Data Relasional</span>
                        <strong style="color:#0f172a;">Microsoft SQL Server</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Verifikasi Dokumen</span>
                        <strong style="color:#0f172a;">Tanda Tangan Digital &amp; QR Code</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Keamanan Akses</span>
                        <span class="status-pill pill-active">Autentikasi Terenkripsi (RBAC)</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">Versi Sistem</span>
                        <strong style="color:#0f172a;">v1.0</strong>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- 2 Equal Columns when no pending leave requests -->
        <div class="col-lg-6 col-md-12">
            <!-- Active Period Card -->
            <div class="admin-card h-100">
                <div class="admin-card-header">
                    <div>
                        <h3 class="admin-card-title">
                            Periode Jadwal Berjalan
                        </h3>
                        <p class="admin-card-desc">Periode jadwal kerja operasional karyawan yang resmi berlaku saat ini</p>
                    </div>
                </div>
                <div class="admin-card-body">
                    @if (Model.ActivePeriod != null)
                    {
                        <div class="p-3 rounded-3" style="background:#f0fdfa; border:1px solid #99f6e4;">
                            <div class="mb-2">
                                <span class="status-pill pill-active" style="font-size: 0.72rem; padding: 2.5px 8.5px; font-weight: 600;">
                                    <span class="dot-indicator pulse-dot"></span>Sedang Berjalan
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
                                <span class="badge" style="background: #ffffff; color: #0f766e; border: 1px solid #99f6e4; font-family: monospace; font-size: 0.78rem; font-weight: 700; padding: 3px 8px;">
                                    @(string.IsNullOrEmpty(Model.ActivePeriod.ScheduleCode) ? $"SCH-{Model.ActivePeriod.Id:D4}" : Model.ActivePeriod.ScheduleCode)
                                </span>
                                <h6 class="fw-bold mb-0 text-slate-900" style="font-size:0.95rem;">@Model.ActivePeriod.PeriodName</h6>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="/Schedule/Detail/@Model.ActivePeriod.Id" class="btn-primary-admin" style="font-size:0.76rem; padding:5px 12px;">
                                    Lihat Jadwal
                                </a>
                                <a href="/Schedule/ExportPdf/@Model.ActivePeriod.Id" target="_blank" class="btn-secondary-admin" style="font-size:0.76rem; padding:5px 12px;">
                                    Dokumen PDF
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted" style="font-size:0.82rem;">
                            Saat ini tidak terdapat periode jadwal operasional yang aktif.
                            <div class="mt-3">
                                <a href="/Schedule/Generate" class="btn-primary-admin" style="font-size:0.76rem;">
                                    Buat Jadwal Baru
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 col-md-12">
            <!-- System & Engine Specs Card -->
            <div class="admin-card h-100">
                <div class="admin-card-header">
                    <div>
                        <h3 class="admin-card-title d-flex align-items-center gap-2">
                            Informasi Sistem
                            <span class="badge" style="background: #f0fdfa; color: #0f766e; border: 1px solid #99f6e4; font-weight: 700; font-size: 0.72rem; padding: 2px 7px;">v1</span>
                        </h3>
                        <p class="admin-card-desc">Parameter arsitektur dan konfigurasi operasional sistem informasi</p>
                    </div>
                </div>
                <div class="admin-card-body p-3" style="font-size:0.78rem;">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Metode Optimasi</span>
                        <strong style="color:#0f172a;">Algoritma Genetika (GA)</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Arsitektur Framework</span>
                        <strong style="color:#0f172a;">ASP.NET Core MVC (Enterprise)</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Basis Data Relasional</span>
                        <strong style="color:#0f172a;">Microsoft SQL Server</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Verifikasi Dokumen</span>
                        <strong style="color:#0f172a;">Tanda Tangan Digital &amp; QR Code</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Keamanan Akses</span>
                        <span class="status-pill pill-active">Autentikasi Terenkripsi (RBAC)</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">Versi Sistem</span>
                        <strong style="color:#0f172a;">v1.0</strong>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
